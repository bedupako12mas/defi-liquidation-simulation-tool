{
  "name": "liquidation-sim-api-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:down": "tsx scripts/migrate.ts down",
    "index:aave": "tsx scripts/index-aave.ts",
    "validate:aave": "tsx scripts/validate-aave.ts",
    "validate:aave-liquidation": "tsx scripts/validate-aave-liquidation.ts",
    "validate:fluid-liquidation": "tsx scripts/validate-fluid-liquidation.ts",
    "sync:validation-results": "tsx scripts/sync-validation-results.ts",
    "sync:liquidation-profitability": "tsx scripts/sync-liquidation-profitability.ts",
    "sync:chained-liquidation": "tsx scripts/sync-chained-liquidation.ts",
    "sync:capped-rate-breach": "tsx scripts/sync-capped-rate-breach.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.1.0",
    "kysely": "^0.29.5",
    "pg": "^8.13.1",
    "viem": "^2.55.16"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
